{
  "name": "mcp-bundle",
  "version": "1.0.0",
  "description": "Enterprise MCP Ecosystem - Production-ready distributed MCP system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "security:semgrep": "semgrep --config=auto --error --quiet .",
    "perf:profile": "clinic doctor -- node dist/index.js",
    "perf:flame": "clinic flame -- node dist/index.js",
    "perf:bubbleprof": "clinic bubbleprof -- node dist/index.js",
    "perf:benchmark": "node scripts/benchmark.js",
    "load-test": "autocannon -c 100 -d 30 http://localhost:9090/health",
    "code-quality": "./scripts/code-quality.sh",
    "pre-commit": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "prepare": "husky install",
    "clean": "rm -rf dist coverage .tsbuildinfo .clinic"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "distributed-systems",
    "enterprise",
    "orchestration"
  ],
  "author": "Your Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/coverage-v8": "^4.0.7",
    "@vitest/ui": "^4.0.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "task-master-ai": "^0.31.2"
  }
}
