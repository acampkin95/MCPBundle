# Environment Variables for MCP Bundle
# Copy this file to .env and fill in the actual values
# NEVER commit the .env file to version control

# ===================================
# Database Credentials
# ===================================
# PostgreSQL admin password for MCP ecosystem database
MCP_DB_PASSWORD=<your-secure-database-password>

# ===================================
# VM Access Credentials
# ===================================
# Root password for VM infrastructure (VMI01, VMI02D, VMI03)
VM_ROOT_PASSWORD=<your-vm-root-password>

# ===================================
# WORM Storage Credentials
# ===================================
# Password for AccessService user on VMI02D WORM area
WORM_ACCESS_PASSWORD=<your-worm-access-password>

# ===================================
# Keycloak Credentials
# ===================================
# Keycloak admin password for authentication management
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>

# ===================================
# Monitoring Credentials
# ===================================
# Password for monitoring services
MONITOR_PASSWORD=<your-monitoring-password>

# ===================================
# Security Notes
# ===================================
# 1. All passwords should be at least 16 characters long
# 2. Use a mix of uppercase, lowercase, numbers, and special characters
# 3. Never reuse passwords across services
# 4. Rotate passwords regularly (every 90 days minimum)
# 5. Store production passwords in a secure vault (e.g., HashiCorp Vault, AWS Secrets Manager)
# 6. For production, use systemd credentials or similar instead of .env files
