# Server Configuration
NODE_ENV=production
PORT=3100
HOST=0.0.0.0

# Database Configuration (VMI01)
DB_HOST=46.250.243.123
DB_PORT=5432
DB_NAME=mcp_vpn_invites
DB_USER=vpn_invite_user
DB_PASSWORD=change_me_in_production
DB_SSL=false

# Keycloak Configuration
KEYCLOAK_URL=http://154.26.158.31:8080
KEYCLOAK_REALM=mcp
KEYCLOAK_CLIENT_ID=vpn-invite-system
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# WireGuard Configuration
WG_INTERFACE=wg1
WG_PORT=51823
WG_SERVER_PUBLIC_KEY=your-server-public-key
WG_SERVER_PRIVATE_KEY=/etc/wireguard/wg1-private.key
WG_ENDPOINT=154.26.158.31:51823
WG_NETWORK=10.10.10.0/24
WG_DNS=10.10.10.1
WG_IP_POOL_START=10.10.10.10
WG_IP_POOL_END=10.10.10.250
WG_ALLOWED_IPS=10.10.10.0/24,10.0.50.0/24,10.0.51.0/24,10.0.52.0/24

# Invite Configuration
INVITE_EXPIRY_HOURS=2
MAX_INVITES_PER_USER=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=change_me_to_random_string_in_production
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/vpn-invite/app.log

# Frontend URL (for CORS)
FRONTEND_URL=http://154.26.158.31:3101
