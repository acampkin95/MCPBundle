# Dependencies
node_modules/
.npm-cache/
.next/

# Build outputs
dist/
build/
*.tsbuildinfo

# Development test packages (gitignored - not for repo)
devtestready/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output/
*.lcov

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment Variables (CRITICAL SECURITY)
# NEVER commit .env files containing real credentials!
# Only .env.example templates should be committed

# Production environment files (NEVER commit)
.env
.env.production
.env.staging

# Local environment overrides (NEVER commit)
.env.local
.env.*.local
.env.development.local
.env.test.local

# Allow .env.example templates (safe to commit)
!.env.example
!.env.production.example
!**/.env.example

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Performance profiling
.clinic/

# Temporary files
tmp/
temp/
*.tmp

# Credentials and Secrets (CRITICAL SECURITY)
# All credential files must be excluded from git
**/credentials*.txt
**/secrets*.txt
**/credentials*.json
**/secrets*.json
**/credentials*.yaml
**/secrets*.yaml
.keys/
**/.keys/
*.key
*.pem
*.p12
*.pfx
**/.credentials/
**/.secrets/

# API keys and tokens
**/api-keys.txt
**/tokens.txt
**/.api-keys/
**/.tokens/

# SSH keys (should use SSH agent, not repo)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# GPG keys
*.gpg
*.asc
secring.gpg

# Certificate files
*.crt
*.cer
*.der
!**/ca-bundle.crt  # Allow CA bundles

# Husky
.husky/_

# Embedded git repositories (manage separately)
.archive/ITJSST-MCP/
.archive/MCP-Orchestrator/
release_dev/perplexity-mcp/

# Large archive files
.archive/*.tar.gz
.archive/*.zip
