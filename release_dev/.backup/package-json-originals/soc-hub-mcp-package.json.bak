{
  "name": "@mcp-bundle/soc-hub-mcp",
  "version": "0.2.0",
  "description": "SOC Hub MCP Server - Unified security operations dashboard with live data integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage .tsbuildinfo"
  },
  "keywords": [
    "mcp",
    "security",
    "soc",
    "siem",
    "wazuh",
    "elasticsearch",
    "thehive",
    "monitoring"
  ],
  "author": "MCP Bundle Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.7",
    "express": "^4.21.1",
    "ws": "^8.18.0",
    "redis": "^4.7.0",
    "zod": "^3.23.8",
    "winston": "^3.15.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "rate-limiter-flexible": "^5.0.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.6",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "@vitest/coverage-v8": "^2.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
