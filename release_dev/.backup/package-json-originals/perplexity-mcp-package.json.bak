{
  "name": "perplexity-mcp",
  "version": "0.2.0",
  "description": "Perplexity-powered Business Intelligence and Research MCP Server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:all": "npm run test:security && npm run test:integration && npm run test",
    "security:codeql": "bash scripts/run-codeql.sh",
    "security:scan": "npm run security:codeql && npm run test:security",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "ci": "npm run type-check && npm run lint && npm run test:coverage && npm run security:scan",
    "clean": "rm -rf dist/ coverage/ .npm-cache/",
    "prebuild": "npm run clean",
    "build:watch": "tsc --watch",
    "dev:debug": "NODE_ENV=development LOG_LEVEL=debug tsx src/index.ts",
    "dev:inspect": "NODE_ENV=development node --inspect -r tsx/register src/index.ts",
    "logs:follow": "tail -f logs/*.log 2>/dev/null || echo 'No log files found'",
    "health:check": "curl -s http://localhost:3000/health | jq || echo 'Server not running or jq not installed'",
    "stats": "npm run test:coverage && npm run lint && npm run type-check",
    "audit:fix": "npm audit fix --production",
    "deps:update": "npm update && npm audit",
    "format": "prettier --write 'src/**/*.ts' || echo 'Install prettier: npm i -D prettier'",
    "format:check": "prettier --check 'src/**/*.ts' || echo 'Install prettier: npm i -D prettier'",
    "docker:build": "docker build -t perplexity-mcp:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env perplexity-mcp:latest",
    "precommit": "npm run lint:fix && npm run type-check",
    "perf:clinic": "clinic doctor -- node dist/index.js",
    "perf:flame": "clinic flame -- node dist/index.js",
    "perf:bubble": "clinic bubbleprof -- node dist/index.js",
    "perf:benchmark": "autocannon -c 10 -d 30 http://localhost:3000/health"
  },
  "keywords": [
    "mcp",
    "perplexity",
    "business-intelligence",
    "research",
    "ai"
  ],
  "author": "ACDev",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "dotenv": "^17.2.3",
    "express-session": "^1.18.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "keycloak-connect": "^26.1.1",
    "pg": "^8.13.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/coverage-v8": "^4.0.7",
    "autocannon": "^8.0.0",
    "benchmark": "^2.1.4",
    "clinic": "^13.0.0",
    "eslint": "^9.39.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
