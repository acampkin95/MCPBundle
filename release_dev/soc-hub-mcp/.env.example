# SOC Hub MCP Server Configuration Template
#
# ⚠️  CRITICAL SECURITY WARNING ⚠️
# This file contains templates for PRODUCTION SECURITY INFRASTRUCTURE
# DO NOT commit real credentials, IPs, or secrets to git!
#
# Copy this file to .env and replace ALL placeholder values:
# Command: cp .env.example .env
# Then edit .env with your actual production credentials
#
# ======================
# Server Configuration
# ======================

# Node Environment
# MUST be 'production' in production deployments!
# Options: development, production, test
NODE_ENV=production

# Server Port
# Default: 3200 (HTTP mode)
# Security: Use reverse proxy (nginx/traefik) with HTTPS termination
PORT=3200

# Log Level
# Production: info or warn
# Development: debug
# Security: Never use debug in production (may leak sensitive data)
LOG_LEVEL=info

# Server Mode
# Options: http, https
# Security: Use 'https' with valid certificates in production
# Note: Can use 'http' behind HTTPS-terminating reverse proxy
SERVER_MODE=http

# ======================
# SOC Services Configuration
# ======================

# Wazuh Manager Configuration
# Wazuh is the SIEM/XDR platform for security monitoring
# Security: NEVER use default credentials in production!
WAZUH_API_URL=https://YOUR_WAZUH_HOST:55000
WAZUH_API_USER=YOUR_WAZUH_USER
WAZUH_API_PASSWORD=YOUR_WAZUH_PASSWORD
WAZUH_VERIFY_SSL=true

# Elasticsearch Configuration
# Backend for Wazuh alert storage and analysis
# Security: Enable authentication and use strong passwords
ELASTICSEARCH_URL=http://YOUR_ELASTICSEARCH_HOST:9200
ELASTICSEARCH_USER=YOUR_ES_USER
ELASTICSEARCH_PASSWORD=YOUR_ES_PASSWORD

# TheHive Configuration
# Incident response and case management platform
# Security: API keys should be generated in TheHive admin panel
THEHIVE_URL=http://YOUR_THEHIVE_HOST:9000
THEHIVE_API_KEY=YOUR_THEHIVE_API_KEY

# Cortex Configuration
# Security orchestration and automated response platform
# Security: API keys should be generated in Cortex admin panel
CORTEX_URL=http://YOUR_CORTEX_HOST:9001
CORTEX_API_KEY=YOUR_CORTEX_API_KEY

# ======================
# Database & Cache Configuration
# ======================

# PostgreSQL Configuration (Persistent Storage)
# Format: postgresql://username:password@host:port/database
# Security:
# - Use strong passwords (20+ chars, mixed case, numbers, symbols)
# - Enable SSL/TLS connections in production
# - Use separate databases for dev/staging/production
# - Restrict network access with firewall rules
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# Redis Configuration (Caching and Pub/Sub)
# Format: redis://[username:password@]host:port[/db]
# Security:
# - Enable Redis AUTH with strong password
# - Bind to localhost or use firewall rules
# - Use TLS for production deployments
# Example with auth: redis://:your_redis_password@YOUR_REDIS_HOST:6379
REDIS_URL=redis://YOUR_REDIS_HOST:6379

# ======================
# Authentication Configuration
# ======================

# Keycloak SSO (Single Sign-On)
# Security: MUST use HTTPS in production!
KEYCLOAK_URL=https://YOUR_KEYCLOAK_HOST:8443
KEYCLOAK_REALM=YOUR_REALM_NAME
KEYCLOAK_CLIENT_ID=YOUR_CLIENT_ID
KEYCLOAK_CLIENT_SECRET=YOUR_CLIENT_SECRET

# JWT Secret for API Token Signing
# Security: Generate with: openssl rand -hex 64
# CRITICAL: Keep this secret! Rotate every 90 days!
JWT_SECRET=YOUR_JWT_SECRET_HERE

# ======================
# Security & Rate Limiting
# ======================

# API Rate Limiting
# Window: 60000ms = 1 minute
# Max Requests: 100 per window per IP
# Adjust based on expected legitimate traffic
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Allowed CORS Origins
# Comma-separated list of allowed origins
# Security: NEVER use '*' in production!
# Examples:
# - Development: http://localhost:3100
# - Production: https://soc.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=https://YOUR_ADMIN_DOMAIN,https://YOUR_SOC_DOMAIN

# ======================
# Monitoring & Alert Configuration
# ======================

# Alert Severity Thresholds
# High severity threshold (1-10 scale)
# Alerts >= this value trigger high-priority notifications
ALERT_HIGH_SEVERITY_THRESHOLD=7

# Critical agent offline threshold
# Number of offline agents before triggering critical alert
ALERT_CRITICAL_AGENTS_OFFLINE=2

# Notification Channels (Optional - Future Feature)
# Slack Webhook for security alerts
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# Discord Webhook for security alerts
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL

# Email SMTP Configuration
EMAIL_SMTP_HOST=YOUR_SMTP_HOST
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=YOUR_SMTP_USER
EMAIL_SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=soc-hub@yourdomain.com

# ======================
# Data Retention Configuration
# ======================

# Cache TTL (Time-To-Live) in seconds
# How long to cache data before refreshing from source
CACHE_TTL_ALERTS=60
CACHE_TTL_AGENTS=300
CACHE_TTL_CASES=120

# Historical Data Retention in days
# How long to keep data before archival/deletion
# Security: Balance compliance requirements with storage costs
RETENTION_ALERTS=30
RETENTION_CASES=90
RETENTION_METRICS=7

# ======================
# PRODUCTION SECURITY CHECKLIST
# ======================
#
# Before deploying to production, verify:
#
# [ ] All placeholders replaced with actual values
# [ ] All default credentials changed (admin/admin, etc.)
# [ ] All passwords are strong (20+ chars, mixed case, numbers, symbols)
# [ ] All URLs use HTTPS (except localhost/internal networks)
# [ ] WAZUH_VERIFY_SSL=true in production
# [ ] NODE_ENV=production
# [ ] LOG_LEVEL=info or warn (NOT debug)
# [ ] ALLOWED_ORIGINS contains only trusted domains (NO wildcards)
# [ ] JWT_SECRET is cryptographically strong (64+ chars)
# [ ] Database uses SSL/TLS connections
# [ ] Redis AUTH is enabled
# [ ] Firewall rules restrict access to SOC services
# [ ] All services use non-default ports (where possible)
# [ ] Monitoring and alerting configured
# [ ] Backup strategy in place
# [ ] Incident response plan documented
#
# ======================
# CREDENTIAL SECURITY BEST PRACTICES
# ======================
#
# 1. SECRETS MANAGEMENT
#    - Use secrets manager (Vault, AWS Secrets Manager, Azure Key Vault)
#    - Never commit .env files to git
#    - Use separate .env files per environment
#    - Encrypt .env files at rest
#
# 2. ACCESS CONTROL
#    - Restrict file permissions: chmod 600 .env
#    - Audit access to .env files
#    - Use principle of least privilege
#    - Implement role-based access control
#
# 3. CREDENTIAL ROTATION
#    - Rotate secrets every 90 days minimum
#    - Rotate immediately if compromise suspected
#    - Document rotation procedures
#    - Test rotation process regularly
#
# 4. NETWORK SECURITY
#    - Use VPN for SOC service access
#    - Implement network segmentation
#    - Use firewall rules to restrict access
#    - Enable SSL/TLS for all external connections
#
# 5. MONITORING
#    - Monitor for exposed credentials (git-secrets, truffleHog)
#    - Alert on failed authentication attempts
#    - Log all credential usage
#    - Review access logs weekly
#
# 6. INCIDENT RESPONSE
#    - If credentials compromised:
#      a. Rotate ALL affected secrets immediately
#      b. Review access logs for unauthorized usage
#      c. Notify security team and stakeholders
#      d. Update .env files across all environments
#      e. Restart all affected services
#      f. Document incident for post-mortem
#
# For detailed security guidance and procedures, see:
# - /shared/docs/SECURE_CREDENTIALS_GUIDE.md
# - /shared/docs/INCIDENT_RESPONSE_PLAYBOOK.md (if available)
# - Your organization's security policies
#
# ======================
# SUPPORT
# ======================
#
# For questions or security concerns:
# - Security issues: security@yourdomain.com
# - Technical support: support@yourdomain.com
# - Documentation: /shared/docs/
