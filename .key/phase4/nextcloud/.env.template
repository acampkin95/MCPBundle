# NextCloud Configuration Template
# Copy this file to .env and fill in your values

# PostgreSQL Database (on VMI01)
POSTGRES_HOST=your_vmi01_ip_or_hostname
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=your_secure_database_password

# Redis Cache (on VMI01 or local)
REDIS_HOST=your_redis_host
REDIS_HOST_PORT=6379
REDIS_PASSWORD=your_redis_password

# NextCloud Admin
NEXTCLOUD_ADMIN_USER=nextcloud-admin
NEXTCLOUD_ADMIN_PASSWORD=your_secure_admin_password

# Domain Configuration
NEXTCLOUD_DOMAIN=cloud.yourdomain.com
NEXTCLOUD_TRUSTED_DOMAINS=cloud.yourdomain.com 46.250.241.70

# SMTP Configuration (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_NAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_DOMAIN=
