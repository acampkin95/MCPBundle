{
  "hostname": "string",
  "backup_type": "daily-incremental|weekly-full|monthly-full",
  "timestamp": "YYYY-MM-DD_HH-MM-SS",
  "date": "YYYY-MM-DD",
  "start_time": "ISO8601",
  "end_time": "ISO8601",
  "duration_seconds": 0,
  "total_size_bytes": 0,
