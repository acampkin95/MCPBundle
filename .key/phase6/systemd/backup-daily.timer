[Unit]
Description=Daily Backup Timer (2 AM)
Requires=backup-daily.service

[Timer]
# Run daily at 2:00 AM
OnCalendar=daily
OnCalendar=*-*-* 02:00:00

# If system was off, run 15 minutes after boot
Persistent=true

# Randomize start time by up to 15 minutes to avoid all VMs starting simultaneously
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
