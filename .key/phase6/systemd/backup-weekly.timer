[Unit]
Description=Weekly Full Backup Timer (Sunday 3 AM)
Requires=backup-weekly.service

[Timer]
# Run every Sunday at 3:00 AM
OnCalendar=Sun *-*-* 03:00:00

# If system was off, run 30 minutes after boot
Persistent=true

# Randomize start time by up to 30 minutes
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
